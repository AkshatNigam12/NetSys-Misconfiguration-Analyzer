# Analyzer2 Configuration
# Copy this file to .env and fill in your values

# MongoDB connection (optional - scanner works without it)
# ANALYZER_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# ANALYZER_DB_NAME=Misconfig_tool
# ANALYZER_SCANS_COLLECTION=Scans

# API server settings
# ANALYZER_API_HOST=127.0.0.1
# ANALYZER_API_PORT=8000
